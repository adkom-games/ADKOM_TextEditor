#editor-row {
    /* Fill leftover space only: without basis 0 + min-height 0 the row sizes
       to its text content and pushes the status bar off the window. */
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

#text-area {
    margin: 0;
    min-height: 0;
}

#text-area .unity-text-field__input {
    -unity-font-style: normal;
    font-size: 13px;
}

#gutter {
    min-width: 40px;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.35);
    -unity-text-align: upper-right;
    padding-right: 4px;
}

#status-bar {
    height: 20px;
    flex-shrink: 0;
    padding: 2px 8px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.35);
}

#status-bar Label {
    font-size: 11px;
    opacity: 0.8;
}
