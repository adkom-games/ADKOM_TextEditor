#tab-bar {
    flex-direction: row;
    flex-shrink: 0;
    flex-wrap: nowrap;
    align-items: stretch;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.35);
}

.tab {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    padding: 2px 2px 2px 8px;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.35);
}

.tab:hover {
    background-color: rgba(128, 128, 128, 0.15);
}

.tab--active {
    background-color: rgba(128, 128, 128, 0.3);
    border-top-width: 2px;
    border-top-color: rgb(90, 150, 255);
}

.tab-scroll-btn {
    font-size: 10px;
    margin: 0;
    padding: 0 3px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-center;
}

.tab-scroll-btn:hover:enabled {
    background-color: rgba(128, 128, 128, 0.3);
}

.menu-btn {
    padding-left: 10px;
    padding-right: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.menu-btn:hover {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(140, 170, 210, 0.8);
    border-right-color: rgba(140, 170, 210, 0.8);
}

.menu-btn:active {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgb(90, 150, 255);
    border-right-color: rgb(90, 150, 255);
}

.tab--dragging {
    opacity: 0.6;
    background-color: rgba(128, 128, 128, 0.45);
}

.tab Label {
    font-size: 11px;
}

.tab__close {
    font-size: 10px;
    margin: 0 2px 0 4px;
    padding: 0 3px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.tab__close:hover {
    background-color: rgba(128, 128, 128, 0.45);
}

#editor-row {
    /* Fill leftover space only: without basis 0 + min-height 0 the row sizes
       to its text content and pushes the status bar off the window. */
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

#text-area {
    margin: 0;
    min-height: 0;
}

#text-area .unity-text-field__input {
    -unity-font-style: normal;
    font-size: 13px;
}

.code-line {
    /* Shared metrics for code lines, the gutter, and the measuring label —
       whitespace must be preserved so glyph x-positions match the model.
       Font family/size are inherited from the CodeView root (configurable). */
    -unity-font-style: normal;
    white-space: pre;
    margin: 0;
    padding: 0;
}

#code-content {
    min-height: 100%;
}

#highlight-overlay {
    /* Must match #text-area input metrics exactly so glyphs line up. */
    font-size: 13px;
    -unity-font-style: normal;
    margin: 0;
    padding: 0;
}

#gutter {
    min-width: 40px;
    flex-shrink: 0;
    overflow: hidden;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.35);
    padding-right: 4px;
}

#gutter Label {
    /* Must match #text-area input metrics so rows align with lines. */
    font-size: 13px;
    -unity-font-style: normal;
    -unity-text-align: upper-right;
    white-space: nowrap;
    opacity: 0.55;
    margin: 0;
    padding: 0;
}

#settings-pane {
    padding: 12px 16px;
}

#settings-pane > * {
    margin-bottom: 6px;
    max-width: 420px;
}

.settings-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

#status-bar {
    height: 20px;
    flex-shrink: 0;
    padding: 2px 8px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.35);
}

#status-bar Label {
    font-size: 11px;
    opacity: 0.8;
}

#console-splitter {
    cursor: split-resize-up-down;
}

#console-splitter:hover {
    background-color: rgba(90, 150, 255, 0.35);
}

#console-pane {
    height: 150px;
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.35);
}

#console-tabs {
    flex-direction: row;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.35);
}

.console-tab {
    flex-direction: row;
    align-items: center;
    padding: 2px 2px 2px 8px;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.35);
    background-color: rgba(128, 128, 128, 0.15);
}

.console-tab Label {
    font-size: 11px;
}

#console-scroll {
    flex-grow: 1;
}

#console-output {
    padding: 2px 6px;
    font-size: 11px;
}
