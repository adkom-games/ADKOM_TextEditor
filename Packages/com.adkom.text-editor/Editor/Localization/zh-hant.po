msgid "differs"
msgstr "不同"

msgid "left"
msgstr "僅左側"

msgid "right"
msgstr "僅右側"

msgid "same"
msgstr "相同"

msgid "{0} change region(s)."
msgstr "{0} 處變更區域。"

