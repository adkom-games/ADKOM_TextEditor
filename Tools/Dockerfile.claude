FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates ripgrep procps less nano \
        && rm -rf /var/lib/apt/lists/*

# gh CLI for GitHub issue/PR work
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y gh && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash dev
USER dev
WORKDIR /home/dev

RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/home/dev/.local/bin:$PATH"

# Keep config (auth, trust, history) inside the mounted claude-home volume,
# otherwise ~/.claude.json is lost on every container exit and login repeats.
ENV CLAUDE_CONFIG_DIR=/home/dev/.claude

WORKDIR /workspace
CMD ["claude"]
