#tab-bar {
    flex-direction: row;
    flex-shrink: 0;
    flex-wrap: wrap;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.35);
}

.tab {
    flex-direction: row;
    align-items: center;
    padding: 2px 2px 2px 8px;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.35);
}

.tab:hover {
    background-color: rgba(128, 128, 128, 0.15);
}

.tab--active {
    background-color: rgba(128, 128, 128, 0.3);
}

.tab Label {
    font-size: 11px;
}

.tab__close {
    font-size: 10px;
    margin: 0 2px 0 4px;
    padding: 0 3px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.tab__close:hover {
    background-color: rgba(128, 128, 128, 0.45);
}

#editor-row {
    /* Fill leftover space only: without basis 0 + min-height 0 the row sizes
       to its text content and pushes the status bar off the window. */
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

#text-area {
    margin: 0;
    min-height: 0;
}

#text-area .unity-text-field__input {
    -unity-font-style: normal;
    font-size: 13px;
}

.code-line {
    /* Shared metrics for code lines, the gutter, and the measuring label —
       whitespace must be preserved so glyph x-positions match the model. */
    font-size: 13px;
    -unity-font-style: normal;
    white-space: pre;
    margin: 0;
    padding: 0;
}

#code-content {
    min-height: 100%;
}

#highlight-overlay {
    /* Must match #text-area input metrics exactly so glyphs line up. */
    font-size: 13px;
    -unity-font-style: normal;
    margin: 0;
    padding: 0;
}

#gutter {
    min-width: 40px;
    flex-shrink: 0;
    overflow: hidden;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.35);
    padding-right: 4px;
}

#gutter Label {
    /* Must match #text-area input metrics so rows align with lines. */
    font-size: 13px;
    -unity-font-style: normal;
    -unity-text-align: upper-right;
    white-space: nowrap;
    opacity: 0.55;
    margin: 0;
    padding: 0;
}

#settings-pane {
    padding: 12px 16px;
}

#settings-pane > * {
    margin-bottom: 6px;
    max-width: 420px;
}

.settings-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

#status-bar {
    height: 20px;
    flex-shrink: 0;
    padding: 2px 8px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.35);
}

#status-bar Label {
    font-size: 11px;
    opacity: 0.8;
}
